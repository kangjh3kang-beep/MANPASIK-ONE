# =============================================================================
# ManPaSik — 환경 변수 템플릿
# 사용법: cp .env.example .env && 값 수정
# =============================================================================

# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=manpasik
DB_PASSWORD=your_db_password_here
DB_NAME=manpasik
DB_SSLMODE=disable

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka (Redpanda) ──
KAFKA_BROKERS=redpanda:19092

# ── JWT ──
JWT_SECRET=your_jwt_secret_min_32_bytes_here

# ── S3 / MinIO ──
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=manpasik

# ── Keycloak ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_password_here

# ── Encryption ──
ENCRYPTION_MASTER_KEY=your_aes256_master_key_32_bytes

# ── Payment Gateway ──
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET_KEY=your_payment_secret_key

# ── AI Model ──
AI_MODEL_API_KEY=your_ai_model_api_key

# ── Notifications ──
FCM_SERVER_KEY=your_fcm_server_key
SMTP_PASSWORD=your_smtp_password

# ── Video ──
VIDEO_STREAM_SECRET=your_video_stream_secret
